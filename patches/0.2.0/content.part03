Zombie Generator";
        return "Zombie Generator";
    }

    private boolean isFuel(FluidStack stack) {
        ResourceLocation id = ForgeRegistries.FLUIDS.getKey(stack.getFluid());
        return id != null && id.getNamespace().equals("enderio") && id.getPath().equals(fuelPath());
    }

    @Override
    public void onLoad() {
        super.onLoad();
        fluidCapability = LazyOptional.of(() -> fuelTank);
    }

    @Override
    public void invalidateCaps() {
        super.invalidateCaps();
        fluidCapability.invalidate();
    }

    @Override
    public <T> @NotNull LazyOptional<T> getCapability(@NotNull Capability<T> cap, @Nullable Direction side) {
        if (cap == ForgeCapabilities.FLUID_HANDLER) return fluidCapability.cast();
        return super.getCapability(cap, side);
    }

    @Override
    public void serverTick() {
        if (level == null || level.isClientSide) return;

        if (active && fuelTank.isEmpty()) active = false;
        if (!active && fuelTank.getFluidAmount() >= START_LEVEL) active = true;

        int generation = generationPerTick();
        if (active && !fuelTank.isEmpty() && energy.getEnergyStored() <= energy.getMaxEnergyStored() - generation) {
            energy.addEnergyInternal(generation, false);
            if (++fuelCounter >= ticksPerMilliBucket()) {
                fuelCounter = 0;
                fuelTank.drain(1, IFluidHandler.FluidAction.EXECUTE);
            }
            setChanged();
        }
        EnergyTransferUtil.pushEnergy(level, worldPosition, energy, 1_000);
    }

    @Override
    public InteractionResult onUse(Player player, InteractionHand hand) {
        if (player.level().isClientSide) return InteractionResult.SUCCESS;
        if (FluidUtil.interactWithFluidHandler(player, hand, fuelTank)) return InteractionResult.CONSUME;
        player.displayClientMessage(Component.literal(machineName() + " — " + energy.getEnergyStored() + "/" + energy.getMaxEnergyStored()
                + " FE | " + fuelName() + " " + fuelTank.getFluidAmount() + "/" + fuelTank.getCapacity() + " mB | "
                + generationPerTick() + " FE/t"), true);
        return InteractionResult.CONSUME;
    }

    @Override
    protected void saveAdditional(CompoundTag tag) {
        super.saveAdditional(tag);
        tag.put("Fuel", fuelTank.writeToNBT(new CompoundTag()));
        tag.putInt("FuelCounter", fuelCounter);
        tag.putBoolean("Active", active);
    }

    @Override
    public void load(CompoundTag tag) {
        super.load(tag);
        // Preserve 0.1.x worlds that used the old Nutrient key.
        if (tag.contains("Fuel")) fuelTank.readFromNBT(tag.getCompound("Fuel"));
        else if (tag.contains("Nutrient")) fuelTank.readFromNBT(tag.getCompound("Nutrient"));
        fuelCounter = tag.getInt("FuelCounter");
        active = tag.getBoolean("Active");
    }
}
''')

