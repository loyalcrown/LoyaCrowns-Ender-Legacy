# Strengthen resource validation: every registered block must have the resources that caused
# the missing-purple-texture problem during the first test build.
validator=root/'tools/validate_assets.py'
base=validator.read_text()
if 'REGISTERED BLOCK RESOURCE AUDIT' not in base:
    base += r'''

# REGISTERED BLOCK RESOURCE AUDIT
import re
java = (ROOT.parents[3] / 'java/com/loyacrown/enderlegacy/registry/LegacyBlocks.java')
if not java.exists():
    # ROOT=.../src/main/resources/assets/ns; jump to src/main then java
    java = ROOT.parents[2] / 'java/com/loyacrown/enderlegacy/registry/LegacyBlocks.java'
text = java.read_text()
registered = sorted(set(re.findall(r'registerBlock\("([a-z0-9_]+)"', text)))
for name in registered:
    required = [
        ROOT/'blockstates'/(name+'.json'),
        ROOT/'models/item'/(name+'.json'),
    ]
    for candidate in required:
        if not candidate.exists():
            errors.append(f'registered block {name} is missing {candidate.relative_to(ROOT)}')
    loot = ROOT.parents[1] / 'data/loyacrowns_ender_legacy/loot_tables/blocks' / (name+'.json')
    if not loot.exists():
        errors.append(f'registered block {name} is missing loot table {loot.name}')
if errors:
    print('\n'.join(errors))
    sys.exit(1)
print(f'Registered-block audit passed for {len(registered)} blocks.')
'''
    # Existing validator exits before this appended block on errors but prints success before audit; okay.
    validator.write_text(base)

# Update reference/status docs.
