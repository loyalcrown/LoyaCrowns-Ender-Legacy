        return 80;
    }

    private int ticksPerMilliBucket() {
        // 5.3.72 defaults: Zombie family 12,000 ticks/bucket; Ender 96,000 ticks/bucket.
        return getBlockState().is(LegacyBlocks.ENDER_GENERATOR.get()) ? 96 : 12;
    }

