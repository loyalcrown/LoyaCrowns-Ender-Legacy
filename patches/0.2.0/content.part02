    }

    private static int capacityFor(BlockState state) {
        if (state.is(LegacyBlocks.ENDER_GENERATOR.get())) return 500_000;
        if (state.is(LegacyBlocks.FRANKEN_ZOMBIE_GENERATOR.get())) return 200_000;
        return 100_000;
    }

    private int generationPerTick() {
